# Copy to cloud.env and fill in. cloud.env is gitignored and must stay that way.
# Run `make cloud-check` after editing. With nothing set, everything runs locally:
# CLOUD_PROVIDER=local, documents under .local-store/, MLflow in a SQLite file.

CLOUD_PROVIDER=local                    # local | azure
PROJECT_ID=itcs355-6688067
REGION=eastasia                         # Azure for Students cannot deploy to southeastasia

# --- capability slots -------------------------------------------------------
# Azure  BLOB_URI=https://<account>.blob.core.windows.net/<container>/bike
#        CONTAINER_REGISTRY=<registry>.azurecr.io/bike
BLOB_URI=
CONTAINER_REGISTRY=

# The self-hosted MLflow server from Lab 2 (infra/tracking-server/ in the course repo).
# File-based stores are rejected by MLflow 3.x; locally the default is sqlite:///mlflow.db.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=               # never commit; the job reads it from a platform secret
MLFLOW_TRACKING_PASSWORD=

MODEL_REGISTRY_NAME=bike-demand
IDENTITY_REF=                           # the job's user-assigned managed identity (resource id)

# Azure ML compute for managed training (Lab 2), as a resource id:
#   /subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<ws>/computes/<name>
TRAINING_TARGET=

BUDGET_LIMIT_THB=800

# --- what the hourly job serves ------------------------------------------------
MODEL_ALIAS=production                  # rollback = point this alias at the previous version
MODEL_VERSION=                          # set only to pin a version, overriding the alias

# --- service levels from the proposal; the alerts are defined by these ---------
WEATHER_MAX_AGE_MIN=60
STALE_MODEL_MAX_AGE_MIN=2880            # model on the last reading for 48 h; baseline after
JOB_MAX_DURATION_S=300

# --- Azure only: where metrics and the job live ---------------------------------
METRICS_RESOURCE_ID=                    # the forecast Container Apps Job; custom metrics attach here
JOB_ENVIRONMENT=bike-env                # Container Apps environment for the two jobs
FORECAST_CRON=0 * * * *                 # hourly; the demo uses */5 * * * * (one tick = one sim hour)

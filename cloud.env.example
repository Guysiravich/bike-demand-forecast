# Copy to cloud.env and fill in. cloud.env is gitignored and must stay that way.
# With nothing set, everything runs locally: CLOUD_PROVIDER=local, a filesystem store under
# .local-store/, and an MLflow SQLite file. The Azure values are filled in after approval.

CLOUD_PROVIDER=local                  # local | azure
PROJECT_ID=itcs355-bike
REGION=eastasia

# Where the job reads its inputs (weather, control) and writes its forecasts.
#   local  a directory; default .local-store/
#   azure  https://<account>.blob.core.windows.net/<container>
STORE_URI=

CONTAINER_REGISTRY=                   # <registry>.azurecr.io/bike

# The course's self-hosted MLflow server, or a local SQLite file by default.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=             # never commit; the job reads it from a platform secret
MLFLOW_TRACKING_PASSWORD=

MODEL_NAME=bike-demand
MODEL_VERSION=                        # empty = serve the `champion` alias
IDENTITY_REF=                         # the job's managed identity

# Service levels from the proposal. The alerts are defined by these.
WEATHER_MAX_AGE_MIN=60
FEED_REPEAT_ALERT=3
JOB_MAX_DURATION_S=300

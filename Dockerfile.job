# The hourly batch job image (course Lab 3's serving image, for a scheduled job).
# One image, two commands: `python -m src.feeder` and `python -m src.forecast`. Runtime
# dependencies only (requirements-job.txt): no pytest, no ruff, no DVC.
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-job.txt ./
RUN pip install --require-hashes --prefix=/install -r requirements-job.txt

FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS runtime
RUN useradd --create-home --uid 10001 runner
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app GIT_PYTHON_REFRESH=quiet
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
RUN mkdir -p /app/data /app/reports && chown -R runner:runner /app
USER runner
# The platform passes the command (src.feeder or src.forecast); this is the default.
ENTRYPOINT ["python", "-m"]
CMD ["src.forecast"]

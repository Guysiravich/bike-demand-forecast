# Secrets and local configuration. Never commit.
cloud.env
*.env
!cloud.env.example

# Data: tracked by DVC, not Git
/data/raw/hour.csv
/data/raw/*.zip

# Local state
.local-store/
mlflow.db
mlruns/
mlartifacts/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.local-*.sh

# Outputs of make targets, regenerated on every run (make reproduce writes metrics.json as the
# container user; a committed copy owned by whoever cloned would block it).
reports/metrics.json
reports/pipeline-metrics.json
reports/gate-decision.txt
reports/candidate.json

# The tracking server's secrets, made by infra/tracking-server/make_secrets.sh on the VM
infra/tracking-server/.env
infra/tracking-server/auth.caddy
